### Phase 6: Testing & Validation (Week 6-7)

#### 6.1 Unit Tests

```python
# tests/test_coordinates.py
def test_coordinate_conversion():
    """Test 0-based to 1-based conversion"""
    start, end = CoordinateConverter.convert(100, 200, '0-based', '1-based')
    assert start == 101
    assert end == 200

def test_chromosome_mapping():
    """Test chromosome ID conversion"""
    mapper = ChromosomeMapper()
    assert mapper.convert('chr1', 'ucsc', 'ensembl') == '1'
    assert mapper.convert('1', 'ensembl', 'ucsc') == 'chr1'

# tests/test_parsers.py
def test_bed_parser():
    """Test BED file parsing"""
    parser = BEDParser()
    df = parser.parse('tests/data/test.bed')
    assert 'chr' in df.columns
    assert 'start' in df.columns
    assert 'end' in df.columns
```

#### 6.2 Integration Tests

```python
# tests/test_integration.py
def test_full_annotation_workflow():
    """Test complete annotation workflow"""
    # Load files
    coords = BEDParser().parse('tests/data/coordinates.bed')
    annots = GFFParser().parse('tests/data/annotations.gff')
    
    # Standardize chromosomes
    coords = ChromosomeMapper().standardize(coords, 'ucsc')
    annots = ChromosomeMapper().standardize(annots, 'ucsc')
    
    # Annotate
    engine = AnnotationEngine()
    result = engine.intersect(coords, annots)
    
    assert len(result) > 0
    assert 'gene_id' in result.columns
```

