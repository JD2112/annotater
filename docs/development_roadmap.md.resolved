### Phase 5: Streamlit User Interface (Week 5-6)

#### 5.1 Application Layout

```python
import streamlit as st

def main():
    st.set_page_config(
        page_title="AnnotateR - Genomic Coordinate Annotation",
        page_icon="🧬",
        layout="wide"
    )
    
    # Sidebar
    with st.sidebar:
        st.title("⚙️ Configuration")
        
        # Coordinate system settings
        st.subheader("Coordinate System")
        coord_system = st.selectbox(
            "Input file coordinate system",
            options=["Auto-detect", "0-based (BED)", "1-based (GFF/GTF)"]
        )
        
        annot_system = st.selectbox(
            "Annotation file coordinate system",
            options=["Auto-detect", "0-based (BED)", "1-based (GFF/GTF)"]
        )
        
        # Chromosome ID handling
        st.subheader("Chromosome IDs")
        chr_handling = st.radio(
            "Chromosome ID handling",
            options=["Auto-detect and convert", "Manual selection"]
        )
        
        if chr_handling == "Manual selection":
            coord_chr_style = st.selectbox(
                "Coordinate file style",
                ["UCSC (chr1)", "Ensembl (1)", "NCBI (NC_)"]
            )
            annot_chr_style = st.selectbox(
                "Annotation file style",
                ["UCSC (chr1)", "Ensembl (1)", "NCBI (NC_)"]
            )
        
        # Annotation mode
        st.subheader("Annotation Mode")
        mode = st.selectbox(
            "Intersection mode",
            options=list(ANNOTATION_MODES.keys()),
            format_func=lambda x: f"{x}: {ANNOTATION_MODES[x]}"
        )
        
        # Advanced options
        with st.expander("🔧 Advanced Options"):
            use_strand = st.checkbox("Consider strand information")
            min_overlap = st.slider(
                "Minimum overlap fraction",
                0.0, 1.0, 0.0,
                help="Require minimum fraction of overlap (0 = any overlap)"
            )
    
    # Main content
    st.title("🧬 AnnotateR")
    st.markdown("**Genomic Coordinate Annotation Tool**")
    st.markdown("---")
    
    # File uploads
    col1, col2 = st.columns(2)
    
    with col1:
        st.subheader("📁 Coordinate File")
        coord_file = st.file_uploader(
            "Upload coordinate file",
            type=['bed', 'txt', 'csv', 'tsv', 'vcf'],
            help="BED, VCF, or custom format"
        )
        
        if coord_file:
            # Show file preview
            preview_file(coord_file, "coordinate")
    
    with col2:
        st.subheader("📁 Annotation File")
        annot_file = st.file_uploader(
            "Upload annotation file",
            type=['gff', 'gtf', 'gff3', 'bed', 'txt', 'csv', 'tsv'],
            help="GFF, GTF, BED, or custom format"
        )
        
        if annot_file:
            preview_file(annot_file, "annotation")
    
    # Run annotation
    if coord_file and annot_file:
        if st.button("🚀 Run Annotation", type="primary"):
            run_annotation(coord_file, annot_file, mode, coord_system, annot_system)
```

#### 5.2 Column Mapping Interface (for Custom Files)

```python
def show_column_mapper(df, file_type):
    """
    Interactive column mapping for custom files
    """
    st.subheader(f"🗺️ Map Columns - {file_type}")
    
    col_names = df.columns.tolist()
    
    col1, col2, col3 = st.columns(3)
    
    with col1:
        chr_col = st.selectbox(
            "Chromosome column",
            options=col_names,
            index=auto_detect_column(col_names, 'chromosome')
        )
    
    with col2:
        start_col = st.selectbox(
            "Start position column",
            options=col_names,
            index=auto_detect_column(col_names, 'start')
        )
    
    with col3:
        # Optional end column
        end_col = st.selectbox(
            "End position column (optional for SNPs)",
            options=['None'] + col_names,
            index=0
        )
    
    # Additional columns to keep
    keep_cols = st.multiselect(
        "Additional columns to include in output",
        options=[c for c in col_names if c not in [chr_col, start_col, end_col]],
        default=[]
    )
    
    return {
        'chr': chr_col,
        'start': start_col,
        'end': end_col if end_col != 'None' else None,
        'keep': keep_cols
    }
```

#### 5.3 Results Display & Download

```python
def display_results(result_df):
    """
    Display annotation results with download options
    """
    st.success(f"✅ Annotation complete! Found {len(result_df)} overlapping features.")
    
    # Summary statistics
    col1, col2, col3, col4 = st.columns(4)
    col1.metric("Total Annotations", len(result_df))
    col2.metric("Unique Coordinates", result_df['coord_id'].nunique())
    col3.metric("Chromosomes", result_df['chr'].nunique())
    col4.metric("Feature Types", result_df.get('feature', result_df.columns[0]).nunique())
    
    # Preview
    st.subheader("📊 Results Preview")
    st.dataframe(result_df.head(100), use_container_width=True)
    
    # Download options
    st.subheader("⬇️ Download Results")
    
    col1, col2, col3 = st.columns(3)
    
    with col1:
        # TSV download
        tsv = result_df.to_csv(sep='\t', index=False)
        st.download_button(
            label="Download as TSV",
            data=tsv,
            file_name="annotated_coordinates.tsv",
            mime="text/tab-separated-values"
        )
    
    with col2:
        # CSV download
        csv = result_df.to_csv(index=False)
        st.download_button(
            label="Download as CSV",
            data=csv,
            file_name="annotated_coordinates.csv",
            mime="text/csv"
        )
    
    with col3:
        # BED download (if applicable)
        if all(col in result_df.columns for col in ['chr', 'start', 'end']):
            bed = result_df[['chr', 'start', 'end']].to_csv(sep='\t', index=False, header=False)
            st.download_button(
                label="Download as BED",
                data=bed,
                file_name="annotated_coordinates.bed",
                mime="text/plain"
            )
```

